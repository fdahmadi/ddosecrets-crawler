# Copy beside docker-compose.yml, then edit hosts and secrets:
#   cp .env.example .env
#   docker compose up -d --build
#
# PostgreSQL and MinIO run on separate hosts (see devops/postgres and devops/minio).
# Empty values fall back to config.docker.yaml / config.docker.laptop.yaml.

# config.docker.yaml (full) or config.docker.laptop.yaml (laptop preview)
CONFIG_NAME=config.docker.yaml

# Must match POSTGRES_* in devops/postgres/.env
DATABASE_URL=postgresql://ddosecrets:CHANGE_ME@db-host:5432/ddosecrets

# Must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD / MINIO_BUCKET in devops/minio/.env
# Endpoint is host:port with no scheme (secure is set in the YAML config).
MINIO_ENDPOINT=minio-host:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=ddosecrets-mirror

# minio or local
STORAGE_BACKEND=minio
