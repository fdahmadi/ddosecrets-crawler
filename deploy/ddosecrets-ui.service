[Unit]
Description=DDoSecrets mirror local web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ddosecrets-crawler
ExecStart=/opt/ddosecrets-crawler/.venv/bin/python -m ddosecrets_crawler serve -c /opt/ddosecrets-crawler/config.yaml --host 0.0.0.0 --port 8090
Restart=always
RestartSec=15
Nice=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
