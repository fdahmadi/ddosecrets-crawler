[Unit]
Description=DDoSecrets continuous mirror crawler (scheduler)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ddosecrets-crawler
ExecStart=/opt/ddosecrets-crawler/.venv/bin/python -m ddosecrets_crawler schedule -c /opt/ddosecrets-crawler/config.yaml
Restart=always
RestartSec=30
Nice=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
